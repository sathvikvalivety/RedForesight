# Splunk MCP Server (official Splunkbase app — runs inside Splunk)
MCP_SERVER_URL=https://localhost:8089/services/mcp
MCP_TOKEN=
MCP_TIMEOUT_SECONDS=30

# Splunk direct
SPLUNK_HOST=localhost
SPLUNK_PORT=8089
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=

# Splunk AI Assistant API (filled in Phase 4)
SPLUNK_AI_API_URL=
SPLUNK_AI_API_KEY=

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_MITRE=mitre_techniques
CHROMA_COLLECTION_EPISODES=incident_episodes

# Agent Tuning
GAME_TREE_DEPTH=3
PROBABILITY_PRUNE_THRESHOLD=0.15
MAX_PREDICTIONS=5
MEMORY_TOP_K=3

# Logging
LOG_LEVEL=INFO